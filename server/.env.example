# ============================================================
# 技遇后端环境配置（复制为 .env 后按需修改）
# ============================================================

# 服务端口
PORT=3000

# 生产环境标识（=production 时强制校验：JWT_SECRET 必须为随机强密钥，禁止默认值）
# NODE_ENV=production

# CORS 白名单（逗号分隔）。空 = 放行无 Origin 的原生客户端/本地调试；
# 生产建议限定前端域名，例如 CORS_ORIGINS=https://jiyu.example.com
CORS_ORIGINS=

# 数据库驱动：sqlite（内置，零配置，推荐本地开发/演示）
#              mysql（生产环境，配合 docker-compose 或自建 MySQL）
DB_DRIVER=sqlite

# SQLite 数据库文件路径（DB_DRIVER=sqlite 时生效）
SQLITE_PATH=./data/jiyu.db

# MySQL 连接（DB_DRIVER=mysql 时生效）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=jiyu
MYSQL_PASSWORD=jiyu123456
MYSQL_DATABASE=jiyu
# MySQL 连接池大小（默认 10）
MYSQL_POOL_SIZE=10

# JWT 签名密钥（生产环境务必改为随机长字符串）
JWT_SECRET=jiyu-dev-secret-change-me
# Token 有效期
JWT_EXPIRES=7d

# 日志级别（trace/debug/info/warn/error，默认 info；生产输出 JSON，本地 TTY 自动美化）
LOG_LEVEL=info

# 客户端版本检查（/api/version 返回；发布新版时更新）
APP_VERSION=1.1.2
UPDATE_MESSAGE=v1.1.2 更新：修复宠物订单风控误拦截；新增忘记密码；评价文字展示与违规申诉
DOWNLOAD_URL=https://github.com/laa200x-arch/jiyu/releases/tag/win-v1.1.2

# 百度 AI 内容审核（可选，配置后启用 AI 图片/文本审核，未配置时使用内置关键词风控）
BAIDU_AI_API_KEY=
BAIDU_AI_SECRET_KEY=

# ============================================================
# 短信验证码（注册手机验证，可插拔通道）
# ============================================================
# 通道：console（测试，验证码直接返回 devCode 自动填入）| aliyun（阿里云）| tencent（腾讯云）
SMS_PROVIDER=console

# 真实通道发送失败时是否降级返回 devCode（测试期 =1 不阻断注册；生产必须 =0，防止验证码泄漏）
SMS_DEV_FALLBACK=1

# --- 阿里云（SMS_PROVIDER=aliyun 时生效）---
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=        # 短信签名（审核通过）
ALIYUN_SMS_TEMPLATE_CODE=    # 模板 Code（须含 ${code} 变量）

# --- 腾讯云（SMS_PROVIDER=tencent 时生效）---
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=      # 短信应用 SmsSdkAppId
TENCENT_SMS_SIGN_NAME=       # 短信签名（审核通过）
TENCENT_SMS_TEMPLATE_ID=     # 模板 ID（正文须含 {1} 占位符）
TENCENT_SMS_REGION=ap-guangzhou

# 是否自动填充演示数据（首次启动）
AUTO_SEED=true
